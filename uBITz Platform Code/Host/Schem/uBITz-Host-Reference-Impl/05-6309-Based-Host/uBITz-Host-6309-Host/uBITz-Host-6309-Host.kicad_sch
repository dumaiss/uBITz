	)
	(text "There are only 1 INT and 1 NMI on Z80, \nall CPU_INTX and CPU_NMI are tied to\nthe 1 INT and 1 NMI"
		(exclude_from_sim no)
		(at 426.974 372.618 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
