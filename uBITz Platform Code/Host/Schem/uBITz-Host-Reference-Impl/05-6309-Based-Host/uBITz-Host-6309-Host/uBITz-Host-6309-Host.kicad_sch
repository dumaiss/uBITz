		(uuid "cdc16fe4-8f9e-45a7-8803-8caea2930143")
	)
	(text "Dual Diodes to power the CPLD only\nfrom JTAB OR from the +5V from the backplane\n\nThis is to allow programming the CPLD from JTAG\nwithout powering the rest of the Host board"
		(exclude_from_sim no)
		(at 372.872 76.708 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d186fec1-db5c-4261-a9ab-13b3942fb607")
	)
	(text "We don't support multiple CPUs\nso LIC, AVMA and TSC are NC"
